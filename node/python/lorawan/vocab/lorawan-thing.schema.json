{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.w3.org/2024/wot/lorawan/lorawan-thing.schema.json",
  "title": "LoRaWAN WoT Binding Thing Metadata",
  "description": "Validation rules for the Thing-level LoRaWAN OTAA identity and onboarding terms within a Thing Description. Secrets (AppKey/NwkKey) must NOT appear here; they are declared as 'apikey' security schemes and injected at runtime.",
  "type": "object",
  "properties": {
    "lorav:devEUI": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{16}$",
      "description": "8-byte device identifier as 16 hexadecimal characters."
    },
    "lorav:joinEUI": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{16}$",
      "description": "8-byte join/application identifier as 16 hexadecimal characters."
    },
    "lorav:macVersion": {
      "type": "string",
      "pattern": "^1\\.[01]\\.[0-9]+$",
      "description": "LoRaWAN MAC version, e.g. '1.0.3' or '1.1.0'."
    },
    "lorav:brand": { "type": "string" },
    "lorav:model": { "type": "string" },
    "lorav:hardwareVersion": { "type": "string" },
    "lorav:softwareVersion": { "type": "string" },
    "lorav:region": { "type": "string" },
    "lorav:frequencyPlan": { "type": "string" },
    "lorav:endDeviceId": { "type": "string" }
  },
  "not": {
    "anyOf": [
      { "required": ["lorav:appKey"] },
      { "required": ["lorav:nwkKey"] },
      { "required": ["lorav:appkey"] },
      { "required": ["lorav:nwkkey"] }
    ]
  },
  "additionalProperties": true
}
