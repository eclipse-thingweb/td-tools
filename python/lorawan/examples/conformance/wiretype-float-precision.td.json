        "type": "number"
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:byteOffset": 2,
          "lorav:wireType": "f32"
        }
      ]
    },
    "f64_minus_quarter": {
      "data": {
        "type": "number"
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:byteOffset": 6,
          "lorav:wireType": "f64"
        }
      ]
    }
