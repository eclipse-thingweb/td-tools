    }
  ],
  "@type": "Thing",
  "id": "urn:dev:conformance:wiretype-float-precision",
  "title": "wire type: float precision",
  "description": "IEEE-754 half, single and double precision at their declared widths.",
  "securityDefinitions": {
    "nosec_sc": {
      "scheme": "nosec"
    }
  },
  "security": "nosec_sc",
  "lorav:payloadLayout": "fixed",
