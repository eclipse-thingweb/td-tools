{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "lorav": "https://www.w3.org/2024/wot/lorawan#",
      "schema": "https://schema.org/",
      "brick": "https://brickschema.org/schema/Brick#",
      "knx": "http://schema.knx.org/2020/ontology/knx#",
      "qudt": "http://qudt.org/schema/qudt/",
      "qunit": "http://qudt.org/vocab/unit/",
      "quantitykind": "http://qudt.org/vocab/quantitykind/",
      "qudt:unit": { "@type": "@id" },
      "qudt:hasQuantityKind": { "@type": "@id" },
      "knx:datapointType": { "@type": "@id" }
    }
  ],
  "@type": ["Thing", "brick:Sensor_Equipment"],
  "id": "urn:dev:milesight:em300-th",
  "title": "milesight_em300_th",
  "description": "Milesight EM300-TH outdoor temperature & humidity sensor (channel/type/value payload on fPort 85).",
  "securityDefinitions": {
    "otaa_sc": {
      "scheme": "apikey",
      "in": "uri",
      "name": "appKey",
      "description": "LoRaWAN OTAA AppKey (root key). Injected at runtime by the Servient; never stored in this TD."
    }
  },
  "security": "otaa_sc",
  "base": "lorawan://A84041B98D5CB233/{appKey}/device",
  "lorav:devEUI": "A84041B98D5CB233",
  "lorav:joinEUI": "0000000000000001",
  "lorav:macVersion": "1.0.3",
  "schema:manufacturer": "Milesight",
  "schema:mpn": "EM300-TH",
  "schema:version": "1.0",
  "schema:softwareVersion": "1.7",
  "lorav:region": "EU868",
  "lorav:frequencyPlan": "EU_863_870",
  "lorav:payloadLayout": "tlv",
  "lorav:tagFields": [
    {
      "name": "channel_id",
      "type": "u8"
    },
    {
      "name": "channel_type",
      "type": "u8"
    }
  ],
  "lorav:defaultEventingFrequencyMinutes": 10,
  "brick:hasLocation": { "@id": "urn:example:location:TTC_fair" },
  "brick:hasPoint": [
    { "@id": "urn:dev:milesight:em300-th#temperature" },
    { "@id": "urn:dev:milesight:em300-th#humidity" }
  ],
  "events": {
    "battery": {
      "data": {
        "type": "integer",
        "unit": "%",
        "qudt:unit": "qunit:PERCENT",
        "qudt:hasQuantityKind": "quantitykind:DimensionlessRatio"
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:tag": [
            1,
            117
          ],
          "lorav:wireType": "xsd:unsignedByte"
        }
      ]
    },
    "temperature": {
      "@id": "urn:dev:milesight:em300-th#temperature",
      "@type": "brick:Temperature_Sensor",
      "knx:datapointType": "knx:valueTemp",
      "data": {
        "type": "number",
        "unit": "Cel",
        "qudt:unit": "qunit:DEG_C",
        "qudt:hasQuantityKind": "quantitykind:Temperature",
        "minimum": -30,
        "maximum": 70
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:tag": [
            3,
            103
          ],
          "lorav:wireType": "xsd:short",
          "lorav:endian": "little",
          "lorav:divisor": 10
        }
      ]
    },
    "humidity": {
      "@id": "urn:dev:milesight:em300-th#humidity",
      "@type": "brick:Relative_Humidity_Sensor",
      "knx:datapointType": "knx:valueHumidity",
      "data": {
        "type": "number",
        "unit": "%RH",
        "qudt:unit": "qunit:PERCENT_RH",
        "qudt:hasQuantityKind": "quantitykind:RelativeHumidity",
        "minimum": 0,
        "maximum": 100
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:tag": [
            4,
            104
          ],
          "lorav:wireType": "xsd:unsignedByte",
          "lorav:divisor": 2
        }
      ]
    }
  }
}
