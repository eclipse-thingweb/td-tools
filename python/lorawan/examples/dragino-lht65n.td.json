{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "lorav": "https://www.w3.org/2024/wot/lorawan#",
      "schema": "https://schema.org/",
      "brick": "https://brickschema.org/schema/Brick#",
      "knx": "http://schema.knx.org/2020/ontology/knx#",
      "qudt": "http://qudt.org/schema/qudt/",
      "qunit": "http://qudt.org/vocab/unit/",
      "quantitykind": "http://qudt.org/vocab/quantitykind/",
      "qudt:unit": { "@type": "@id" },
      "qudt:hasQuantityKind": { "@type": "@id" },
      "knx:datapointType": { "@type": "@id" }
    }
  ],
  "@type": ["Thing", "brick:Sensor_Equipment"],
  "id": "urn:dev:dragino:lht65n",
  "title": "dragino_lht65n",
  "description": "Dragino LHT65N temperature & humidity sensor. This TD models key fPort-aware uplinks from the official codec: fPort 2 extension/status telemetry (including retransmission/poll/extension status bits and basic battery/temperature/humidity extraction) and fPort 5 device-info telemetry. Unsupported advanced shapes (for example fPort 3 variable-length temperature arrays and extensionCode-specific alternate battery/DS-temperature sources) remain out of scope for this example.",
  "securityDefinitions": {
    "otaa_sc": {
      "scheme": "apikey",
      "in": "uri",
      "name": "appKey",
      "description": "LoRaWAN OTAA AppKey (root key). Injected at runtime by the Servient; never stored in this TD."
    }
  },
  "security": "otaa_sc",
  "base": "lorawan://A84041B98D5CB233/{appKey}/device",
  "lorav:devEUI": "A84041B98D5CB233",
  "lorav:joinEUI": "0000000000000000",
  "lorav:macVersion": "1.0.3",
  "schema:manufacturer": "Dragino",
  "schema:mpn": "LHT65N",
  "schema:version": "1.0",
  "schema:softwareVersion": "1.4",
  "lorav:region": "EU868",
  "lorav:frequencyPlan": "EU_863_870",
  "lorav:payloadLayout": "ports",
  "lorav:defaultEventingFrequencyMinutes": 10,
  "brick:hasLocation": { "@id": "urn:example:location:TTC_fair" },
  "brick:hasPoint": [
    { "@id": "urn:dev:dragino:lht65n#temperature" },
    { "@id": "urn:dev:dragino:lht65n#humidity" }
  ],
  "events": {
    "retransmissionStatus": {
      "description": "fPort 2 retransmission status bit (byte 6, bit 7). Official branch of interest decodes sensor values when this is 0.",
      "data": {
        "type": "integer"
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:fPort": 2,
          "lorav:byteOffset": 6,
          "lorav:wireType": "xsd:unsignedByte",
          "lorav:bitmask": "0x80"
        }
      ]
    },
    "pollMessageStatus": {
      "description": "fPort 2 poll-message status bit (byte 6, bit 6). Official branch of interest decodes sensor values when this is 0.",
      "data": {
        "type": "integer"
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:fPort": 2,
          "lorav:byteOffset": 6,
          "lorav:wireType": "xsd:unsignedByte",
          "lorav:bitmask": "0x40"
        }
      ]
    },
    "extensionCode": {
      "description": "fPort 2 extension discriminator (byte 6, low nibble). Used to select the temperature/battery decoding path.",
      "data": {
        "type": "integer"
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:fPort": 2,
          "lorav:byteOffset": 6,
          "lorav:wireType": "xsd:unsignedByte",
          "lorav:bitmask": "0x0F"
        }
      ]
    },
    "batteryVoltage": {
      "description": "fPort 2 battery voltage (`BatV`) from bytes 0..1 (basic extraction path).",
      "data": {
        "type": "number",
        "unit": "V",
        "qudt:unit": "qunit:V",
        "qudt:hasQuantityKind": "quantitykind:Voltage"
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:fPort": 2,
          "lorav:byteOffset": 0,
          "lorav:wireType": "xsd:unsignedShort",
          "lorav:multiplier": 0.001
        }
      ]
    },
    "temperature": {
      "@id": "urn:dev:dragino:lht65n#temperature",
      "@type": "brick:Temperature_Sensor",
      "knx:datapointType": "knx:valueTemp",
      "description": "fPort 2 SHT temperature (`TempC_SHT`) from bytes 2..3.",
      "data": {
        "type": "number",
        "unit": "Cel",
        "qudt:unit": "qunit:DEG_C",
        "qudt:hasQuantityKind": "quantitykind:Temperature",
        "minimum": -40,
        "maximum": 85
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:fPort": 2,
          "lorav:byteOffset": 2,
          "lorav:wireType": "xsd:short",
          "lorav:multiplier": 0.01
        }
      ]
    },
    "humidity": {
      "@id": "urn:dev:dragino:lht65n#humidity",
      "@type": "brick:Relative_Humidity_Sensor",
      "knx:datapointType": "knx:valueHumidity",
      "description": "fPort 2 humidity from bytes 4..5 (basic extraction path).",
      "data": {
        "type": "number",
        "unit": "%RH",
        "qudt:unit": "qunit:PERCENT_RH",
        "qudt:hasQuantityKind": "quantitykind:RelativeHumidity",
        "minimum": 0,
        "maximum": 96
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:fPort": 2,
          "lorav:byteOffset": 4,
          "lorav:wireType": "xsd:unsignedShort",
          "lorav:multiplier": 0.1
        }
      ]
    }
  }
}
