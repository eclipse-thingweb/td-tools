{
  "td": "mclimate-mc-button.td.json",
  "description": "MClimate Multipurpose Button keepalive vectors based on the official codec: battery scaling, thermistor-connectivity bit mapped through lorav:valueMap, 10-bit temperature, and press event code.",
  "vectors": [
    {
      "name": "single_press_connected",
      "payload": "01AF00F801",
      "expected": {
        "frameType": 1,
        "batteryVoltage": 3.0,
        "thermistorProperlyConnected": true,
        "sensorTemperature": 24.8,
        "pressEvent": 1
      }
    },
    {
      "name": "double_press_disconnected",
      "payload": "01A004F402",
      "expected": {
        "frameType": 1,
        "batteryVoltage": 2.88,
        "thermistorProperlyConnected": false,
        "sensorTemperature": 24.4,
        "pressEvent": 2
      }
    },
    {
      "name": "triple_press_zero_temp",
      "payload": "018C000003",
      "expected": {
        "frameType": 1,
        "batteryVoltage": 2.72,
        "thermistorProperlyConnected": true,
        "sensorTemperature": 0.0,
        "pressEvent": 3
      }
    },
    {
      "name": "triple_press_temp",
      "payload": "01AB029B03",
      "expected": {
        "frameType": 1,
        "batteryVoltage": 2.968,
        "thermistorProperlyConnected": true,
        "sensorTemperature": 15.5,
        "pressEvent": 3
      }
    }
  ]
}