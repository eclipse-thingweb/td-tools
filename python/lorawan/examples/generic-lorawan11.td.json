{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "lorav": "https://www.w3.org/2024/wot/lorawan#",
      "schema": "https://schema.org/",
      "brick": "https://brickschema.org/schema/Brick#",
      "knx": "http://schema.knx.org/2020/ontology/knx#",
      "qudt": "http://qudt.org/schema/qudt/",
      "qunit": "http://qudt.org/vocab/unit/",
      "quantitykind": "http://qudt.org/vocab/quantitykind/",
      "qudt:unit": { "@type": "@id" },
      "qudt:hasQuantityKind": { "@type": "@id" },
      "knx:datapointType": { "@type": "@id" }
    }
  ],
  "@type": ["Thing", "brick:Sensor_Equipment"],
  "id": "urn:dev:example:generic-lorawan11",
  "title": "generic_lorawan11_sensor",
  "description": "Generic LoRaWAN 1.1 sensor demonstrating OTAA with both AppKey and NwkKey (fixed binary uplink layout).",
  "securityDefinitions": {
    "appkey_sc": {
      "scheme": "apikey",
      "in": "uri",
      "name": "appKey",
      "description": "LoRaWAN OTAA AppKey (root key). Injected at runtime; never stored in this TD."
    },
    "nwkkey_sc": {
      "scheme": "apikey",
      "in": "uri",
      "name": "nwkKey",
      "description": "LoRaWAN 1.1 OTAA NwkKey (network root key, required for MAC version 1.1.x). Injected at runtime; never stored in this TD."
    }
  },
  "security": [
    "appkey_sc",
    "nwkkey_sc"
  ],
  "base": "lorawan://70B3D57ED0050001/{appKey}/{nwkKey}/device",
  "lorav:devEUI": "70B3D57ED0050001",
  "lorav:joinEUI": "0000000000000001",
  "lorav:macVersion": "1.1.0",
  "schema:manufacturer": "Example",
  "schema:mpn": "GLW11",
  "schema:version": "1.0",
  "schema:softwareVersion": "1.0",
  "lorav:region": "EU868",
  "lorav:frequencyPlan": "EU_863_870",
  "lorav:payloadLayout": "fixed",
  "lorav:defaultEventingFrequencyMinutes": 10,
  "brick:hasLocation": { "@id": "urn:example:location:TTC_fair" },
  "brick:hasPoint": [
    { "@id": "urn:dev:example:generic-lorawan11#temperature" }
  ],
  "events": {
    "battery": {
      "description": "Battery level as a percentage.",
      "data": {
        "type": "integer",
        "unit": "%",
        "qudt:unit": "qunit:PERCENT",
        "qudt:hasQuantityKind": "quantitykind:DimensionlessRatio",
        "minimum": 0,
        "maximum": 100
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:byteOffset": 0,
          "lorav:wireType": "xsd:unsignedByte"
        }
      ]
    },
    "temperature": {
      "@id": "urn:dev:example:generic-lorawan11#temperature",
      "@type": "brick:Temperature_Sensor",
      "knx:datapointType": "knx:valueTemp",
      "data": {
        "type": "number",
        "unit": "Cel",
        "qudt:unit": "qunit:DEG_C",
        "qudt:hasQuantityKind": "quantitykind:Temperature",
        "minimum": -40,
        "maximum": 85
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:byteOffset": 1,
          "lorav:wireType": "xsd:short",
          "lorav:multiplier": 0.1
        }
      ]
    }
  }
}
